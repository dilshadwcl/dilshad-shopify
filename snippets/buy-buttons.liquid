{% doc %}
  Renders a product form with add-to-cart and dynamic checkout buttons.

  @param {block} block - The buy-buttons block, whose settings control the form and whose attributes are added to the wrapper.
  @param {product} product - The product to purchase.
  @param {string} product_form_id - The product form's unique ID.
  @param {string} section_id - The section ID used to namespace the form and submit button.
  @param {boolean} [show_pickup_availability] - Whether to render pickup availability. Defaults to `false`.
  @param {boolean} [personalization_poc_enabled] - Whether to render the local personalization POC inputs.
  @param {object} [section] - The current section context, supplied implicitly when rendered from a section and used for IDs and pickup-availability colors.

  @example
  {% render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true %}
{% enddoc %}
<div {{ block.shopify_attributes }}>
  {%- if product != blank -%}
    {%- liquid
      assign gift_card_recipient_feature_active = false
      if block.settings.show_gift_card_recipient and product.gift_card?
        assign gift_card_recipient_feature_active = true
      endif

      assign show_dynamic_checkout = false
      if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false and personalization_poc_enabled != true
        assign show_dynamic_checkout = true
      endif
    -%}

    <product-form
      class="product-form"
      data-hide-errors="{{ gift_card_recipient_feature_active }}"
      data-section-id="{{ section.id }}"
    >
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        <span class="product-form__error-message"></span>
      </div>

      {%- assign quantity_rule_soldout = false -%}

      {%- form 'product',
        product,
        id: product_form_id,
        class: 'form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          {% if product.selected_or_first_available_variant.available == false
            or quantity_rule_soldout
            or product.selected_or_first_available_variant == null
          %}
            disabled
          {% endif %}
          class="product-variant-id"
        >

        {%- if personalization_poc_enabled -%}
          <div class="personalization-poc">
            {%- assign alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' | split: '' -%}
            <fieldset class="product-form__input personalization-poc__letters" data-personalization-letters>
              <legend class="form__label">Select letter:</legend>
              <div class="personalization-poc__letter-grid">
                {%- for letter in alphabet -%}
                  <div>
                    <input
                      class="visually-hidden"
                      type="radio"
                      id="PersonalizationLetter-{{ section_id }}-{{ letter }}"
                      name="properties[Letter]"
                      value="{{ letter }}"
                      {% if forloop.first %}checked{% endif %}
                    >
                    <label for="PersonalizationLetter-{{ section_id }}-{{ letter }}">{{ letter }}</label>
                  </div>
                {%- endfor -%}
              </div>
            </fieldset>

            <div class="product-form__input">
              <label class="form__label" for="PersonalizationName-{{ section_id }}">Personalised name</label>
              <input
                id="PersonalizationName-{{ section_id }}"
                class="field__input"
                type="text"
                name="properties[Personalised name]"
                placeholder="e.g. Amanda Matthews"
                maxlength="30"
                required
                aria-describedby="PersonalizationHint-{{ section_id }}"
                data-personalization-name
              >
              <small id="PersonalizationHint-{{ section_id }}">Up to 30 characters. Your name appears on the mug as you type.</small>
            </div>

            <div class="product-form__input product-form__input--dropdown">
              <label class="form__label" for="PersonalizationFont-{{ section_id }}">Font style</label>
              <div class="select">
                <select
                  id="PersonalizationFont-{{ section_id }}"
                  class="select__select"
                  name="properties[Font]"
                  data-personalization-font
                >
                  <option value="Classic">Classic</option>
                  <option value="Modern">Modern</option>
                  <option value="Script">Script</option>
                </select>
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
          </div>
        {%- endif -%}

        {%- if gift_card_recipient_feature_active -%}
          {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
        {%- endif -%}

        <div class="product-form__buttons">
          {%- liquid
            assign check_against_inventory = true
            if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
              assign check_against_inventory = false
            endif
            if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
              assign quantity_rule_soldout = true
            endif
          -%}
          <button
            id="ProductSubmitButton-{{ section_id }}"
            type="submit"
            name="add"
            class="product-form__submit button button--full-width {% if show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"
            {% if product.selected_or_first_available_variant.available == false
              or quantity_rule_soldout
              or product.selected_or_first_available_variant == null
            %}
              disabled
            {% endif %}
          >
            <span>
              {%- if product.selected_or_first_available_variant == null -%}
                {{ 'products.product.unavailable' | t }}
              {%- elsif product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
                {{ 'products.product.sold_out' | t }}
              {%- else -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- endif -%}
            </span>
            {%- render 'loading-spinner' -%}
          </button>
          {%- if show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>
      {%- endform -%}
    </product-form>
  {%- else -%}
    <div class="product-form">
      <div class="product-form__buttons form">
        <button
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--primary"
          disabled
        >
          {{ 'products.product.sold_out' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- if show_pickup_availability -%}
    {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

    {%- liquid
      assign show_physical_stores = block.settings.show_physical_stores
      assign listed_store_count = 0
      for availability in product.selected_or_first_available_variant.store_availabilities
        if availability.pick_up_enabled
          assign listed_store_count = listed_store_count | plus: 1
        elsif show_physical_stores and availability.physical_storefront and availability.available_without_transfer
          assign listed_store_count = listed_store_count | plus: 1
        endif
      endfor
    -%}

    <pickup-availability
      class="product__pickup-availabilities quick-add-hidden"
      {% if product.selected_or_first_available_variant.available and listed_store_count > 0 %}
        available
      {% endif %}
      data-availability-section="{% if show_physical_stores %}store-availability{% else %}pickup-availability{% endif %}"
      data-root-url="{{ routes.root_url }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-has-only-default-variant="{{ product.has_only_default_variant }}"
      data-product-page-color-scheme="gradient color-{{ section.settings.color_scheme }}"
    >
      <template>
        <pickup-availability-preview class="pickup-availability-preview">
          <span class="svg-wrapper">
            {{- 'icon-unavailable.svg' | inline_asset_content -}}
          </span>
          <div class="pickup-availability-info">
            <p class="caption-large">{{ 'products.product.pickup_availability.unavailable' | t }}</p>
            <button class="pickup-availability-button link link--text underlined-link">
              {{ 'products.product.pickup_availability.refresh' | t }}
            </button>
          </div>
        </pickup-availability-preview>
      </template>
    </pickup-availability>

    <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
</div>
